{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "coverageDirectory": "coverage-e2e",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/.pnpm/(?!(@nestjs\\+event-emitter)@)"
  ],
  "moduleNameMapper": {
    "^@xenova/transformers$": "<rootDir>/test/mocks/xenova-transformers.mock.ts"
  }
}
